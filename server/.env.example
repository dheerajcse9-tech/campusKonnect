# ---- Core ----
NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed to call the API (the web client)
CLIENT_ORIGIN=http://localhost:5173
# Public base URL of the web client, used to build links in emails
APP_URL=http://localhost:5173
# Public base URL of this API, used to build URLs for locally stored uploads
API_URL=http://localhost:4000

# ---- Database ----
DATABASE_URL=postgresql://campus:campus@localhost:5432/campuskonnect?schema=public

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Only these email domains may register (comma-separated)
ALLOWED_EMAIL_DOMAINS=college.edu
# Cookie SameSite policy for the refresh cookie: lax (same-site) or none (cross-site, requires HTTPS)
COOKIE_SAMESITE=lax

# ---- Email (optional: logs emails to the console if unset) ----
RESEND_API_KEY=
EMAIL_FROM=CampusKonnect <no-reply@campuskonnect.app>

# ---- Images (optional: stores files on local disk if unset) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Networking ----
# Number of reverse proxies in front of the API (Render/Railway/Heroku: 1)
TRUST_PROXY=1
